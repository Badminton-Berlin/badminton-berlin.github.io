rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function adminsDoc() { return /databases/$(db)/documents/settings/admins; }
    function isAdmin() {
      return signedIn() && exists(adminsDoc()) && (request.auth.uid in get(adminsDoc()).data.uids);
    }
    function eventDoc() { return /databases/$(db)/documents/settings/event; }
    function registrationOpen() {
      return !exists(eventDoc()) || !("registrationOpen" in get(eventDoc()).data) || get(eventDoc()).data.registrationOpen == true;
    }
    function playerScoresAllowed() {
      return exists(eventDoc()) && get(eventDoc()).data.allowPlayerScores == true;
    }
    function isMember() { return signedIn() && exists(/databases/$(db)/documents/players/$(request.auth.uid)); }
    function meDoc() { return get(/databases/$(db)/documents/players/$(request.auth.uid)).data; }
    function myTeam() { return meDoc().team; }
    // An inactive member keeps their profile and their own costs, nothing else.
    function isActiveMember() { return isMember() && (!("active" in meDoc()) || meDoc().active != false); }
    // Club admin: an active member with role "clubAdmin" for that club. May add/deactivate members, edit the club setup, invite.
    function isClubAdmin(t) { return isActiveMember() && myTeam() == t && ("role" in meDoc()) && meDoc().role == "clubAdmin"; }
    function manages(t) { return isAdmin() || isClubAdmin(t); }
    // An event is visible to a member when their club is listed in its clubs array.
    function canSeeEvent(eventId) {
      return isActiveMember() && exists(/databases/$(db)/documents/events/$(eventId))
        && myTeam() in get(/databases/$(db)/documents/events/$(eventId)).data.clubs;
    }
    // A club admin organises an event that belongs to their club alone.
    function evDoc(eventId) { return /databases/$(db)/documents/events/$(eventId); }
    function clubEventAdmin(eventId) {
      return exists(evDoc(eventId)) && get(evDoc(eventId)).data.clubs.size() == 1
        && isClubAdmin(get(evDoc(eventId)).data.clubs[0]);
    }
    function organises(eventId) { return isAdmin() || clubEventAdmin(eventId); }
    function signupOpen(eventId) {
      return exists(evDoc(eventId)) && (!("regOpen" in get(evDoc(eventId)).data) || get(evDoc(eventId)).data.regOpen != false);
    }
    // settings/sharing = {"AB": true} for each pair of clubs that currently share an event (kept up to date by the admin app).
    // Members may read another club's players only while such an event exists.
    function sharingDoc() { return /databases/$(db)/documents/settings/sharing; }
    function clubsShare(a, b) {
      return a == b || (exists(sharingDoc()) && ((a + b) in get(sharingDoc()).data || (b + a) in get(sharingDoc()).data));
    }
    // A club id is valid when it is one of the two founding clubs or a document in the clubs collection.
    function validClub(t) { return t is string && (t in ["A", "B"] || exists(/databases/$(db)/documents/clubs/$(t))); }
    function inviteDoc(code) { return /databases/$(db)/documents/invites/$(code); }
    // A registration with an invite code is allowed when the code exists, is for that club, hasn't expired and has uses left.
    function validInvite(d) {
      return "invite" in d && d.invite is string && exists(inviteDoc(d.invite))
        && get(inviteDoc(d.invite)).data.team == d.team
        && get(inviteDoc(d.invite)).data.expiresAt > request.time.toMillis()
        && get(inviteDoc(d.invite)).data.used.size() < get(inviteDoc(d.invite)).data.maxUses;
    }
    function validPlayer(d) {
      return d.first is string && d.first.size() > 0 && d.first.size() <= 40
        && d.last is string && d.last.size() <= 40
        && validClub(d.team)
        && (!("dob" in d) || d.dob is string)
        && (!("photo" in d) || (d.photo is string && d.photo.size() <= 90000))
        && (!("paypal" in d) || (d.paypal is string && d.paypal.size() <= 60))
        && (!("iban" in d) || (d.iban is string && d.iban.size() <= 34))
        && (!("ibanName" in d) || (d.ibanName is string && d.ibanName.size() <= 70));
    }

    // Settings collection: every signed-in player may read it (the app loads it as one query).
    match /settings/{doc} {
      allow read: if signedIn();
    }

    // Event settings and the club-sharing map: admins write.
    match /settings/event {
      allow write: if isAdmin();
    }
    match /settings/sharing {
      allow write: if isAdmin();
    }

    // Admin list: the first signed-in person to open the app claims it; after that only admins change it.
    match /settings/admins {
      allow create: if signedIn() && request.resource.data.uids == [request.auth.uid];
      allow update, delete: if isAdmin() && request.auth.uid in request.resource.data.uids;
    }

    // Players: each device registers itself (doc id == its uid) while registration is open; admins manage everyone.
    // Reading members: your own profile always; your club's members; another club's members only while the clubs share an event.
    match /players/{pid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == pid)
                  || (isMember() && clubsShare(myTeam(), resource.data.team));
      allow create: if signedIn() && validPlayer(request.resource.data)
                    && ((request.auth.uid == pid && (registrationOpen() || validInvite(request.resource.data)))
                        || isAdmin() || isClubAdmin(request.resource.data.team))
                    && (isAdmin() || !request.resource.data.keys().hasAny(["canInvite", "role", "active"]));
      // A player edits their own profile but cannot change their rights or status; a club admin manages status and invite rights
      // of their club's members; only a global admin assigns the club-admin role.
      allow update: if signedIn() && validPlayer(request.resource.data)
                    && (isAdmin()
                        || (request.auth.uid == pid
                            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["canInvite", "guest", "sessionOnly", "invite", "role", "active", "deactivatedAt", "deactivatedBy", "team"]))
                        || (isClubAdmin(resource.data.team) && request.resource.data.team == resource.data.team
                            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])));
      allow delete: if isAdmin();
    }

    // Pairs and schedule: readable by members of the clubs in that event (the app queries by eventId); admins write.
    match /pairs/{id} {
      allow read: if isAdmin() || canSeeEvent(resource.data.eventId);
      allow create: if organises(request.resource.data.eventId);
      allow update, delete: if organises(resource.data.eventId);
    }

    // Matches: admins write; registered players may enter scores if the admin switched that on.
    match /matches/{id} {
      allow read: if isAdmin() || canSeeEvent(resource.data.eventId);
      allow create: if organises(request.resource.data.eventId);
      allow delete: if organises(resource.data.eventId);
      allow update: if organises(resource.data.eventId)
        || (signedIn() && playerScoresAllowed()
            && exists(/databases/$(db)/documents/players/$(request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["games", "walkover", "status", "winner", "updatedAt", "updatedBy"])
            && request.resource.data.walkover == resource.data.walkover);
    }

    // Expenses: challenge-day costs are managed by admins; team session costs and payments by that team's members.
    match /expenses/{id} {
      allow read: if isAdmin()
        || (resource.data.scope == "team" && isActiveMember() && resource.data.team == myTeam())
        || (resource.data.scope != "team" && canSeeEvent(resource.data.eventId))
        || (signedIn() && (resource.data.paidBy == request.auth.uid || resource.data.from == request.auth.uid
                           || resource.data.to == request.auth.uid
                           || (("splitAmong" in resource.data) && request.auth.uid in resource.data.splitAmong)));
      allow create, update: if isAdmin()
        || (request.resource.data.scope != "team" && clubEventAdmin(request.resource.data.eventId))
        || (isActiveMember() && request.resource.data.scope == "team" && request.resource.data.team == myTeam()
            && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid)
        || (resource.data.scope != "team" && clubEventAdmin(resource.data.eventId));
    }

    // Events (the challenge and any other event the admins create): everyone reads, admins write.
    match /events/{id} {
      allow read: if isAdmin() || (isActiveMember() && myTeam() in resource.data.clubs);
      allow create, update: if request.resource.data.clubs is list && request.resource.data.clubs.size() > 0
        && (isAdmin() || (request.resource.data.clubs == [myTeam()] && isClubAdmin(myTeam())
                          && (resource == null || resource.data.clubs == [myTeam()])));
      allow delete: if isAdmin() || clubEventAdmin(id);
    }

    // Event sign-ups (doc id "<eventId>_<uid>"): members join/leave their club's events while sign-up is open;
    // organisers and the club's admins add or remove people any time.
    match /eventRegs/{id} {
      allow read: if isAdmin() || canSeeEvent(resource.data.eventId);
      allow create: if id == request.resource.data.eventId + "_" + request.resource.data.uid
        && exists(/databases/$(db)/documents/players/$(request.resource.data.uid))
        && request.resource.data.team == get(/databases/$(db)/documents/players/$(request.resource.data.uid)).data.team
        && ((request.resource.data.uid == request.auth.uid && isActiveMember() && canSeeEvent(request.resource.data.eventId) && signupOpen(request.resource.data.eventId))
            || organises(request.resource.data.eventId)
            || (isClubAdmin(request.resource.data.team) && canSeeEvent(request.resource.data.eventId)));
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && signupOpen(resource.data.eventId))
        || clubEventAdmin(resource.data.eventId) || isClubAdmin(resource.data.team);
    }

    // Team settings (regular session day/time/place): admins or that team's members.
    match /teams/{t} {
      allow read: if isAdmin() || (isActiveMember() && myTeam() == t);
      allow write: if manages(t);
    }

    // Weekly sessions: created/edited by admins or the team's members; votes (rsvps) are part of the document.
    // "Votes are final" (teams/{t}.voteLock == "once"): members may not change or clear a vote that is already set; club admins
    // and admins change it for them. Only exception: away mode setting the member's own vote to "no" (awayAuto) and undoing it.
    function teamVoteFinal(t) {
      return exists(/databases/$(db)/documents/teams/$(t))
        && get(/databases/$(db)/documents/teams/$(t)).data.get("voteLock", "free") == "once";
    }
    function finalVotesKept() {
      let before = resource.data.get("rsvps", {});
      let after = request.resource.data.get("rsvps", {});
      let d = after.diff(before);
      let touched = d.changedKeys().union(d.removedKeys());
      let me = request.auth.uid;
      return touched.size() == 0
        || (touched.hasOnly([me])
            && ((after.get(me, null) == "no" && request.resource.data.get("awayAuto", {}).get(me, 0) == 1)
                || (after.get(me, null) == null && before.get(me, null) == "no" && resource.data.get("awayAuto", {}).get(me, 0) == 1)));
    }
    match /sessions/{id} {
      allow read: if isAdmin() || (isActiveMember() && resource.data.team == myTeam());
      allow create: if isAdmin() || (isActiveMember() && request.resource.data.team == myTeam());
      // "Who played" (attended) is fixed by admins / club admins only; members change just their own vote.
      allow update: if isAdmin() || (isActiveMember() && request.resource.data.team == myTeam() && resource.data.team == myTeam()
                                     && (isClubAdmin(myTeam()) || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["attended"])
                                                                   && (!teamVoteFinal(myTeam()) || finalVotesKept()))));
      allow delete: if isAdmin();
    }

    // Invites: created by admins or members with invite rights (for their own club); anyone signed in can look one up by code;
    // a registering person appends their own uid to "used"; the creator or an admin can delete.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if (isAdmin() || isClubAdmin(request.resource.data.team)
                        || (isActiveMember() && ("canInvite" in meDoc()) && meDoc().canInvite == true && request.resource.data.team == myTeam()))
                    && request.resource.data.createdBy == request.auth.uid
                    && validClub(request.resource.data.team)
                    && request.resource.data.kind in ["member", "guest", "session"]
                    && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 50
                    && request.resource.data.used == [];
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "updatedAt"])
                    && request.resource.data.used == resource.data.used.concat([request.auth.uid])
                    && resource.data.used.size() < resource.data.maxUses;
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Activity log: every signed-in member appends entries about their own actions; admins read all, club admins their club's.
    match /audit/{id} {
      allow read: if isAdmin() || (resource.data.team is string && isClubAdmin(resource.data.team));
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
                    && request.resource.data.action is string && request.resource.data.action.size() <= 30
                    && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow update, delete: if false;
    }

    // Season archives: frozen statistics; admins write, members of the listed clubs read.
    match /seasons/{id} {
      allow read: if isAdmin() || (isActiveMember() && myTeam() in resource.data.clubs);
      allow write: if isAdmin();
    }

    // Payment requests: a member asks a club-mate for money. Requester and payer read it (admins and the club's admins too);
    // the payer can mark it paid/declined, the requester can cancel or re-notify.
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid))
                  || (resource.data.team is string && isClubAdmin(resource.data.team));
      allow create: if isActiveMember() && request.resource.data.from == request.auth.uid && request.resource.data.team == myTeam()
                    && request.resource.data.to is string && request.resource.data.to != request.auth.uid
                    && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
                    && request.resource.data.status == "open";
      allow update: if isAdmin()
        || (signedIn() && resource.data.to == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "paidAt", "declinedAt", "expenseId", "paidNotify", "updatedAt"])
            && request.resource.data.status in ["paid", "declined"])
        || (signedIn() && resource.data.from == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "notifyPending", "remindedAt", "cancelledAt", "updatedAt"])
            && request.resource.data.status in ["open", "cancelled"]);
      allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
    }

    // Clubs: everyone signed in reads the list; admins manage it.
    match /clubs/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.resource.data.name is string && request.resource.data.short is string;
      allow delete: if isAdmin();
    }

    // Push notification tokens: each device writes its own; only admins (and the reminder job) read them.
    match /pushTokens/{u} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == u);
      allow write: if signedIn() && request.auth.uid == u;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
