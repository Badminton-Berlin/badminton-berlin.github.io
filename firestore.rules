rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function adminsDoc() { return /databases/$(db)/documents/settings/admins; }
    function isAdmin() {
      return signedIn() && exists(adminsDoc()) && (request.auth.uid in get(adminsDoc()).data.uids);
    }
    function eventDoc() { return /databases/$(db)/documents/settings/event; }
    function registrationOpen() {
      return !exists(eventDoc()) || !("registrationOpen" in get(eventDoc()).data) || get(eventDoc()).data.registrationOpen == true;
    }
    function playerScoresAllowed() {
      return exists(eventDoc()) && get(eventDoc()).data.allowPlayerScores == true;
    }
    function isMember() { return signedIn() && exists(/databases/$(db)/documents/players/$(request.auth.uid)); }
    function myTeam() { return get(/databases/$(db)/documents/players/$(request.auth.uid)).data.team; }
    // An event is visible to a member when their club is listed in its clubs array.
    function canSeeEvent(eventId) {
      return isMember() && exists(/databases/$(db)/documents/events/$(eventId))
        && myTeam() in get(/databases/$(db)/documents/events/$(eventId)).data.clubs;
    }
    function inviteDoc(code) { return /databases/$(db)/documents/invites/$(code); }
    // A registration with an invite code is allowed when the code exists, is for that club, hasn't expired and has uses left.
    function validInvite(d) {
      return "invite" in d && d.invite is string && exists(inviteDoc(d.invite))
        && get(inviteDoc(d.invite)).data.team == d.team
        && get(inviteDoc(d.invite)).data.expiresAt > request.time.toMillis()
        && get(inviteDoc(d.invite)).data.used.size() < get(inviteDoc(d.invite)).data.maxUses;
    }
    function validPlayer(d) {
      return d.first is string && d.first.size() > 0 && d.first.size() <= 40
        && d.last is string && d.last.size() <= 40
        && d.team in ["A", "B"]
        && (!("dob" in d) || d.dob is string)
        && (!("photo" in d) || (d.photo is string && d.photo.size() <= 90000));
    }

    // Settings collection: every signed-in player may read it (the app loads it as one query).
    match /settings/{doc} {
      allow read: if signedIn();
    }

    // Event settings: admins write.
    match /settings/event {
      allow write: if isAdmin();
    }

    // Admin list: the first signed-in person to open the app claims it; after that only admins change it.
    match /settings/admins {
      allow create: if signedIn() && request.resource.data.uids == [request.auth.uid];
      allow update, delete: if isAdmin() && request.auth.uid in request.resource.data.uids;
    }

    // Players: each device registers itself (doc id == its uid) while registration is open; admins manage everyone.
    match /players/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && validPlayer(request.resource.data)
                    && ((request.auth.uid == pid && (registrationOpen() || validInvite(request.resource.data))) || isAdmin())
                    && (isAdmin() || !("canInvite" in request.resource.data));
      // A player edits their own profile but cannot grant themselves invite rights or upgrade from guest; admins can do everything.
      allow update: if signedIn() && validPlayer(request.resource.data)
                    && (isAdmin() || (request.auth.uid == pid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["canInvite", "guest", "sessionOnly", "invite"])));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == pid);
    }

    // Pairs and schedule: readable by members of the clubs in that event (the app queries by eventId); admins write.
    match /pairs/{id} {
      allow read: if isAdmin() || canSeeEvent(resource.data.eventId);
      allow write: if isAdmin();
    }

    // Matches: admins write; registered players may enter scores if the admin switched that on.
    match /matches/{id} {
      allow read: if isAdmin() || canSeeEvent(resource.data.eventId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && playerScoresAllowed()
            && exists(/databases/$(db)/documents/players/$(request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["games", "walkover", "status", "winner", "updatedAt", "updatedBy"])
            && request.resource.data.walkover == resource.data.walkover);
    }

    // Expenses: challenge-day costs are managed by admins; team session costs and payments by that team's members.
    match /expenses/{id} {
      allow read: if isAdmin()
        || (resource.data.scope == "team" && isMember() && resource.data.team == myTeam())
        || (resource.data.scope != "team" && canSeeEvent(resource.data.eventId));
      allow create, update: if isAdmin()
        || (isMember() && request.resource.data.scope == "team" && request.resource.data.team == myTeam()
            && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Events (the challenge and any other event the admins create): everyone reads, admins write.
    match /events/{id} {
      allow read: if isAdmin() || (isMember() && myTeam() in resource.data.clubs);
      allow write: if isAdmin() && request.resource.data.clubs is list && request.resource.data.clubs.size() > 0;
    }

    // Team settings (regular session day/time/place): admins or that team's members.
    match /teams/{t} {
      allow read: if isAdmin() || (isMember() && myTeam() == t);
      allow write: if isAdmin() || (isMember() && myTeam() == t);
    }

    // Weekly sessions: created/edited by admins or the team's members; votes (rsvps) are part of the document.
    match /sessions/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.team == myTeam());
      allow create, update: if isAdmin() || (isMember() && request.resource.data.team == myTeam());
      allow delete: if isAdmin();
    }

    // Invites: created by admins or members with invite rights (for their own club); anyone signed in can look one up by code;
    // a registering person appends their own uid to "used"; the creator or an admin can delete.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if (isAdmin() || (isMember() && get(/databases/$(db)/documents/players/$(request.auth.uid)).data.canInvite == true
                                      && request.resource.data.team == myTeam()))
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.team in ["A", "B"]
                    && request.resource.data.kind in ["member", "guest", "session"]
                    && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 50
                    && request.resource.data.used == [];
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "updatedAt"])
                    && request.resource.data.used == resource.data.used.concat([request.auth.uid])
                    && resource.data.used.size() < resource.data.maxUses;
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Push notification tokens: each device writes its own; only admins (and the reminder job) read them.
    match /pushTokens/{u} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == u);
      allow write: if signedIn() && request.auth.uid == u;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
